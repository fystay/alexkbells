# Copy to .env.local for local development. Never commit real values.
# All variables are read on the server at build time; none are exposed to the browser.

# Canonical public origin, used for metadata, sitemap and structured data.
# Production example: https://www.alexkbells.co.uk (domain not yet confirmed)
SITE_URL=

# External booking page (https only). Leave empty until the provider is confirmed;
# class CTAs then fall back to "Enquire about classes" -> /contact.
BOOKING_URL=

# "true" shows provisional prices/timetable with a visible "awaiting confirmation"
# marker for client review. Set it for Vercel *Preview* only. It is ignored on
# Vercel production (VERCEL_ENV=production) as a safety net. See DEPLOYMENT.md.
CONTENT_PREVIEW=

# On-site booking request form (/book). All three must be set and valid, or the
# form stays off and buttons fall back as above. Requests are emailed to Alex via
# Resend (https://resend.com); nothing is stored by the site. The from-address
# must be on a domain verified in Alex's Resend account. Server-only: never use
# a NEXT_PUBLIC_ prefix. /book is prerendered, so redeploy after changing these.
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
# e.g. Alex K Bells <bookings@your-verified-domain>
BOOKING_FROM_EMAIL=
# "true" shows the booking calendar with labelled DEMONSTRATION availability so
# Alex can try it. Nothing is booked or sent. Previews/local only: ignored on
# Vercel production (VERCEL_ENV=production).
BOOKING_DEMO=

# Tests only: override the Resend endpoint (https, or http://localhost).
RESEND_API_URL=

# Tests only: path to a preinstalled Chromium for Playwright (optional).
PLAYWRIGHT_CHROMIUM_PATH=
